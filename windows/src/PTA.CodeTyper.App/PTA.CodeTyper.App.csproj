<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PTA.CodeTyper.App</RootNamespace>
    <AssemblyName>PTA Code Typer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <!-- Use the PRI targets AND task DLL bundled together in WindowsAppSDK. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PTA.CodeTyper.Core\PTA.CodeTyper.Core.csproj" />
    <ProjectReference Include="..\PTA.CodeTyper.Windows\PTA.CodeTyper.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
  <Target Name="CheckPriBuildTools" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(MsixTaskAssembly)' == '' or !Exists('$(MsixTaskAssembly)')"
           Text="Bundled WindowsAppSDK PRI build tasks are missing. Restore this project's NuGet packages before publishing." />
  </Target>
</Project>
