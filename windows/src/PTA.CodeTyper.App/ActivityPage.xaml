<Page
    x:Class="PTA.CodeTyper.App.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PTA.CodeTyper.App">

    <Grid RowDefinitions="*,Auto">
        <!-- Main Log List Area -->
        <Grid Grid.Row="0">
            <!-- Empty State -->
            <StackPanel Visibility="{x:Bind ViewModel.EmptyLogsVisibility, Mode=OneWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <FontIcon Glyph="&#xE81C;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="还没有运行记录" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="开始输入后，可在这里查看备份和校验结果。" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- List View -->
            <ListView ItemsSource="{x:Bind ViewModel.Logs}"
                Visibility="{x:Bind ViewModel.LogsListVisibility, Mode=OneWay}"
                SelectionMode="None"
                Padding="24,16">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LogEntry">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,6">
                            <!-- Icon -->
                            <FontIcon Grid.Column="0"
                                Glyph="{x:Bind IconGlyph}"
                                FontSize="14"
                                Foreground="{x:Bind ColorBrush}"
                                VerticalAlignment="Top"
                                Margin="0,3,0,0" />

                            <!-- Details -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind Message}" Style="{ThemeResource BodyTextBlockStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind TimeString}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="记录可能包含个人代码，请妥善保管。" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.OpenReportsCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xED25;" FontSize="14" />
                        <TextBlock Text="打开记录文件夹" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
